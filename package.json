{
  "name": "job-agent",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/scraper",
    "packages/api",
    "packages/ui"
  ],
  "scripts": {
    "scraper": "npm run dev -w packages/scraper",
    "scraper:phase3": "npm run phase3 -w packages/scraper",
    "scraper:phase3:force": "npm run phase3:force -w packages/scraper",
    "scraper:gmail-alerts": "npx tsx packages/scraper/src/phase-gmail-alerts.ts --watch --interval=60",
    "scraper:phase4": "npm run phase4 -w packages/scraper",
    "api": "NODE_ENV=development npm run start:dev -w packages/api",
    "api:prod": "NODE_ENV=production npm run start -w packages/api",
    "ui": "npm run dev -w packages/ui",
    "lint": "eslint packages/*/src --ext .ts,.tsx",
    "format": "prettier --write packages/*/src",
    "scraper:verify": "npm run verify-slugs -w packages/scraper",
    "eval:answers": "npm run eval:answers -w packages/scraper",
    "eval:cover-letters": "npm run eval:cover-letters -w packages/scraper",
    "eval:form-pre-answer": "npm run eval:form-pre-answer -w packages/scraper",
    "eval:scorer": "npm run eval:scorer -w packages/scraper",
    "eval:all": "npm run eval:all -w packages/scraper",
    "eval:seed-rules": "npm run eval:seed-rules -w packages/scraper",
    "eval:seed-demographics": "npm run eval:seed-demographics -w packages/scraper",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "dompurify": "^3.4.0"
  }
}
